{
  "$defs": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "$ref": "#/$defs/id"
    },
    "interactions": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_ids": {
            "items": {
              "$ref": "#/$defs/id"
            },
            "minItems": 1,
            "type": "array"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "evidence_sets": {
            "items": {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "minItems": 1,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "expected_amount_minor": {
            "minimum": 1,
            "type": "integer"
          },
          "interaction_group": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "issue_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "duplicate_invoice",
              "missing_or_partial_allocation",
              "fx_wrong_date_or_rate",
              "period_cutoff_error"
            ],
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "type",
          "affected_ids",
          "expected_amount_minor",
          "currency",
          "evidence_sets",
          "interaction_group"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "issues",
    "interactions"
  ],
  "type": "object"
}
