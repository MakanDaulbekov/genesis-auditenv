{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "episode_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "affected_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "claimed_amount_minor": {
            "type": "integer"
          },
          "currency": {
            "maxLength": 64,
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "explanation": {
            "maxLength": 1000,
            "type": "string"
          },
          "type": {
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "type": "array"
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "type": "object"
}
