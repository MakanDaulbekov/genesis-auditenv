{
  "$defs": {
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "episode_id": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_ids": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "type": "array"
          },
          "claimed_amount_minor": {
            "minimum": 0,
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Za-z]{3}$",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "explanation": {
            "maxLength": 1000,
            "type": "string"
          },
          "type": {
            "enum": [
              "duplicate_invoice",
              "missing_or_partial_allocation",
              "fx_wrong_date_or_rate",
              "period_cutoff_error"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "affected_ids",
          "claimed_amount_minor",
          "currency",
          "evidence_ids",
          "explanation"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "type": "array"
    }
  },
  "required": [
    "episode_id",
    "findings"
  ],
  "type": "object"
}
